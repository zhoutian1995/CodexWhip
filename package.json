{
  "name": "codexwhip",
  "version": "1.5.0",
  "description": "A dark desktop whip for Codex Desktop on Windows and macOS",
  "author": "zhoutian1995",
  "license": "MIT",
  "main": "main.js",
  "os": [
    "win32",
    "darwin"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "codex",
    "desktop",
    "windows",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhoutian1995/CodexWhip.git"
  },
  "bugs": {
    "url": "https://github.com/zhoutian1995/CodexWhip/issues"
  },
  "homepage": "https://github.com/zhoutian1995/CodexWhip#readme",
  "scripts": {
    "prestart": "node scripts/build-macos-helper.js",
    "start": "electron .",
    "dev": "electron .",
    "assets:brand": "electron scripts/generate-brand-assets.js",
    "assets:sounds": "node scripts/generate-whip-sounds.js",
    "assets": "npm run assets:brand && npm run assets:sounds",
    "test": "node --test",
    "test:visual": "electron scripts/overlay-visual-smoke.js",
    "pack": "electron-builder --dir",
    "build:mac-helper": "node scripts/build-macos-helper.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "npm run build:mac-helper && electron-builder --mac dmg zip --arm64"
  },
  "devDependencies": {
    "electron": "41.7.1",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "app-builder-lib": {
      "@noble/hashes": "1.8.0"
    }
  },
  "build": {
    "appId": "com.weiling.codexwhip",
    "productName": "CodexWhip",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "lib/**/*",
      "sounds/**/*",
      "icon/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icon/icon.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "scripts/codex-desktop-ui.ps1",
          "to": "scripts/codex-desktop-ui.ps1"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "icon/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "CodexWhip ${version} macOS ${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "build/macos/codex-desktop-ui",
          "to": "scripts/codex-desktop-ui"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "CodexWhip Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "CodexWhip Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "smol-toml": "^1.7.1"
  }
}
